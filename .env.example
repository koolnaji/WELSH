# Where pipeline data (audio, transcriptions, mutations, summaries, queues)
# is stored. Omit this variable to use ~/welsh_analysis.
WELSH_ANALYSIS_DIR=C:\path\to\welsh_analysis

# Optional Cysill API access.
WELSH_LEMMATIZER=

# Optional local Bangor lexicon lookup (see README Setup step 5).
# Defaults to bangor_lexicon/lecsicon_cc0.txt (relative to wherever you
# run the pipeline from) if unset.
BANGOR_LEXICON_PATH=

# Optional yt-dlp cookie auth (see README Environment variables). Helps
# avoid YouTube's caption-endpoint rate limiting, whose cooldown has been
# reported to run into the hours -- set at most ONE (file wins if both):
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=

# Optional completion-email notifications.
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
NOTIFY_RECIPIENT=
